POSTGRES_USER=recon
POSTGRES_PASSWORD=recon
POSTGRES_DB=recon
# Host port for Postgres; change it if 5432 is already taken on your machine
DB_PORT=5432

# Shown in the audit log; there is no login
ACCOUNTANT_NAME=accountant
MANAGER_NAME=manager

# Service ports (host bindings are fixed in docker-compose.yml)
API_PORT=3000
MCP_PORT=3001
